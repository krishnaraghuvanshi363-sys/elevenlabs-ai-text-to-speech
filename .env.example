# ==============================================================================
# ElevenLabs API Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy or rename this file to ".env" (without the .example extension).
# 2. Get your free API key from: https://elevenlabs.io (Profile -> API Keys)
# 3. Paste your key below after the "=" sign.
# 4. Save the file and start your server (npm start).
# ==============================================================================

# Your ElevenLabs API Key (keep this private!)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Port for the Node.js server to run on (Default: 3000)
PORT=3000
